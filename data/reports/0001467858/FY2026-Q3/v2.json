  "segments": [
    {
      "name": "GM 北美",
      "text": "调整 EBIT 为 35.92 亿美元、调整利润率 8.7%，上年同期分别为 25.06 亿美元和 6.2%。这是主要经营改善来源，但两者属于调整指标，不能替代集团 GAAP 营业利润率。",
      "evidence_ids": [
        "business-segment-1"
      ]
    },
    {
      "name": "GM 国际",
      "text": "调整 EBIT 为 0.28 亿美元，上年同期 2.26 亿美元；中国权益收益为 0.32 亿美元，上年同期 0.80 亿美元。权益法合资企业收益不等于合并地区收入，不能只凭这些利润项目推断地区销售增速。",
      "evidence_ids": [
        "business-segment-2"
      ]
    },
    {
      "name": "GM Financial",
      "text": "调整税前利润为 6.68 亿美元，上年同期 8.04 亿美元，属于金融活动的调整税前口径，不同于汽车 EBIT 或汽车自由现金流。后续需要核对信贷表现、融资成本及租赁残值来解释下降。",
      "evidence_ids": [
        "business-segment-3"
      ]
    }
  ],
