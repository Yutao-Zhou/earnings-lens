  "segments": [
    {
      "name": "数据中心",
      "text": "收入 85.46 亿美元，同比约增 96.9%，营业利润 28.82 亿美元。分部包含服务器 CPU、AI 加速器及其他数据中心产品，范围大于 GPU 收入。",
      "evidence_ids": [
        "business-segment-1"
      ]
    },
    {
      "name": "客户端与游戏",
      "text": "合计收入 37.22 亿美元，上年同期为 40.48 亿美元；其中客户端从 27.50 亿美元增至 29.49 亿美元，游戏从 12.98 亿美元降至 7.73 亿美元。合计下降掩盖了不同需求趋势，产品拆分不能再与分部总额重复相加。",
      "evidence_ids": [
        "business-segment-2"
      ]
    },
    {
      "name": "嵌入式",
      "text": "收入从 8.57 亿美元增至 11.09 亿美元，营业利润从 2.83 亿美元增至 4.53 亿美元。业务恢复有利于分散增长来源，但相对较小的收入基数，尚不能替代集团对数据中心增长的依赖。",
      "evidence_ids": [
        "business-segment-3"
      ]
    }
  ],
