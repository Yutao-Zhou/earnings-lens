  "segments": [
    {
      "name": "AWS 云业务",
      "text": "459.84 亿美元收入对应 177.73 亿美元营业利润；公告披露收入增长约 39.3%。容量利用率、折旧和客户需求将决定基础设施扩张后当前较高的营业利润率能否延续。",
      "evidence_ids": [
        "business-segment-1"
      ]
    },
    {
      "name": "北美零售分部",
      "text": "收入 1128.52 亿美元，营业利润 87.23 亿美元。这里是最大的收入来源，但利润率明显低于 AWS。评价同比时应同时考虑 Prime Day 时点和履约成本，不能用云业务增长替代零售需求判断。",
      "evidence_ids": [
        "business-segment-2"
      ]
    },
    {
      "name": "国际零售分部",
      "text": "收入 431.08 亿美元，营业利润 15.80 亿美元。报告增速还受汇率影响。由于分部利润率较低，即使收入变化看起来温和，物流效率、产品组合和本地定价的变化仍可能显著影响利润。",
      "evidence_ids": [
        "business-segment-3"
      ]
    }
  ],
