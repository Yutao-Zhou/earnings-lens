  "guidance": [],
  "segments": [
    {
      "name": "航天分部",
      "text": "收入 17.67 亿美元，营业亏损 0.07 亿美元，上年同期营业利润为 2.59 亿美元；分部资本投入 16.06 亿美元。发射收入与开发支出存在时点差异，发射里程碑本身不足以证明短期现金盈利。",
      "evidence_ids": [
        "business-segment-1"
      ]
    },
    {
      "name": "连接业务分部",
      "text": "收入 52.48 亿美元，营业利润 23.67 亿美元，计算营业利润率约 45.1%；企业与政府收入 21.27 亿美元，消费者收入 31.21 亿美元。用户增长与 ARPU 需要结合客户结构变化解读。",
      "evidence_ids": [
        "business-segment-2"
      ]
    },
    {
      "name": "Super Intelligence（SI）分部",
      "text": "收入 75.60 亿美元，营业利润 4.31 亿美元，上年同期营业亏损 17.22 亿美元；资本投入 164.44 亿美元超过当季收入。扩张改善了经营结果，同时形成较大的后续利用率和融资要求。",
      "evidence_ids": [
        "business-segment-3"
      ]
    }
  ],
