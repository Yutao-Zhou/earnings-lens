  "guidance": [],
  "segments": [
    {
      "name": "美国需求",
      "text": "调整后同店销售增长 7.2%，客流增长 3.2%，调整后客单价增长 3.9%；报告同店增长 10.7%。应将基础消费与汽油、汇率影响分开。财年末美国地区仓库 647 家；增长率不能当作分部收入金额。",
      "evidence_ids": [
        "demand",
        "outlook"
      ]
    },
    {
      "name": "加拿大与其他国际市场",
      "text": "加拿大调整后同店销售增长 4.6%、客流增长 2.5%；其他国际市场分别增长 6.2% 和 4.5%。这些衡量可比门店需求，并非包含新店在内的全部增长贡献；剔除汇率后的增长也不能直接证明当地营业利润率改善。",
      "evidence_ids": [
        "demand"
      ]
    },
    {
      "name": "会员与数字化参与",
      "text": "数字化发起的同店销售增长 19.5%，剔除汇率后 19.8%；订单可能由仓库、配送中心或 Costco Travel 履约。这是渠道指标，不是可额外相加的收入分部。应结合续费率和 Executive 会员参与程度跟踪，不能与地区销售重复相加。",
      "evidence_ids": [
        "demand",
        "membership"
      ]
    }
  ],
