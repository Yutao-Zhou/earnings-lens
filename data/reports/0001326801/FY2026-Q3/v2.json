  "limitations": [
    "依据已列明的官方申报、业绩及财务附件进行分析；尚未完成官方电话会文字材料审阅。",
    "业务类别、地区拆分、报告分部与调整指标采用各自披露范围，不能重复相加或替代合并 GAAP 数值。",
    "现金流采用单季金额，累计披露按相邻期间相减；公司调整口径、融资租赁和激励款等差异见指标定义。",
    "未保留披露前市场一致预期快照，不作超预期判断；未来指引与分析推断不等于已实现结果。"
  ],
  "summary": {
    "text": "广告需求与价格支撑收入增长，但诉讼费用压低营业利润，基础设施现金投入超过经营现金流。上年同期很高的税率也放大了 EPS 同比增幅。应分别观察广告核心业务、Reality Labs 亏损、法律现金义务和 AI 投资，再评价表面上的盈利增长。",
    "evidence_ids": [
      "research-income",
      "research-cash",
      "business-detail-1",
      "business-detail-2",
      "business-detail-3"
    ]
  },
  "findings": [
    {
      "kind": "fact",
      "text": "营业收入 646.01 亿美元，同比变化 26.07%；GAAP 摊薄 EPS 为 3.83 美元，上年同期为 1.05 美元。这些是 2026-07-01 至 2026-09-30 的已实现单季结果，需结合业务组合及特殊项目评价合并同比。",
      "evidence_ids": [
        "metric-revenue",
        "metric-diluted_eps"
      ]
    },
    {
      "kind": "inference",
      "text": "GAAP 营业利润为 129.88 亿美元，除以收入后，营业利润率约为 20.105%，上年同期约 40.075%。财务表另保留 GAAP 毛利率 79.305%。毛利率和营业利润率对应不同费用层级，都不等于资本投入后的现金结余或既有资产回报。",
      "evidence_ids": [
        "research-income"
      ]
    },
    {
      "kind": "inference",
      "text": "经营现金流为 327.86 亿美元，物业购置 339.42 亿美元加融资租赁本金 9.64 亿美元，超过经营回款，使公司口径自由现金流为负 21.20 亿美元，上年同期为正 106.25 亿美元。只扣设备购置会高估这一指标。诉讼费用确认与和解付款也有时点差异，不能把费用直接当成本季已支付现金。",
      "evidence_ids": [
        "research-cash",
        "metric-free_cash_flow"
      ]
    },
    {
      "kind": "fact",
      "text": "广告展示量同比增长 10%，平均单价增长 14%；广告收入 630.61 亿美元，包含在 Family of Apps 的 641.58 亿美元收入中。量与价都支撑了收入，但相乘舍入增速只能近似解释，不能据此拆出汇率、业务组合或每个应用的贡献。",
      "evidence_ids": [
        "business-detail-1"
      ]
    },
    {
      "kind": "inference",
      "text": "98.9 亿美元法律费用使营业利润降至 129.88 亿美元；公司说明剔除该费用的 EPS 为 7.40 美元，而 GAAP 为 3.83 美元。同时，有效税率从上年同期 87% 降至 24%。因此，报告 EPS 约 265% 的同比增幅，不等于持续广告经营业务的增长率。",
      "evidence_ids": [
        "business-detail-2"
      ]
    },
    {
      "kind": "risk",
      "text": "管理层预计第四季度收入 730 至 760 亿美元，全年含租赁本金的资本投入 1350 至 1450 亿美元。与州检察长的协议涉及最高约 185.9 亿美元付款，范围不只本季计提。资本计划与法律协议具有不同的预期及义务口径，需继续跟踪基础设施回报和实际法律付款节奏。",
      "evidence_ids": [
        "business-detail-3"
      ]
    }
  ]
}
