  "segments": [
    {
      "name": "Rockstar 与主机游戏",
      "text": "既有《GTA》系列数字收入增长，部分抵消了其他游戏走弱。《GTA VI》是下一财季的新品，届时可用主机净预订额、完整游戏收入和递延收入来区分首发销售与后续确认。",
      "evidence_ids": [
        "ttwo-review-games",
        "ttwo-review-launch",
        "take-two-net-bookings"
      ]
    },
    {
      "name": "移动游戏与持续性玩家消费",
      "text": "移动游戏收入包含在游戏内购买和广告等长期变现业务中。季度披露把《Color Block Jam》和《Match Factory!》的走弱列为持续性消费收入下滑的主要原因；后续可一起观察移动端收入和持续性消费绝对额。",
      "evidence_ids": [
        "ttwo-review-rcs",
        "take-two-recurrent-spending-revenue"
      ]
    }
  ],
  "follow_ups": [
    {
      "id": "take-two-follow-up-1",
      "status": "monitoring",
      "question": "《GTA VI》首发如何转化为业绩？",
      "update": "用第三财季披露的净预订额与收入对照本次指引，跟踪主机业务和递延收入。",
      "next_check": "下一次正式财报披露。",
      "evidence_ids": [
        "ttwo-review-launch",
        "take-two-guidance-2026-12-31-bookings",
        "take-two-guidance-2026-12-31-revenue"
      ]
    },
    {
      "id": "take-two-follow-up-2",
      "status": "monitoring",
      "question": "持续性玩家消费收入能否恢复增长？",
      "update": "比较移动业务收入与持续性消费绝对额，核对公司是否披露关键游戏和玩家获取成本。",
      "next_check": "下一次正式财报披露。",
      "evidence_ids": [
        "take-two-recurrent-spending-revenue",
        "ttwo-review-rcs",
        "ttwo-review-dependencies"
      ]
    },
    {
      "id": "take-two-follow-up-3",
      "status": "monitoring",
      "question": "新品销售何时带来自由现金流改善？",
      "update": "从下一期累计现金流中扣除本期累计值，核对单季经营现金流、现金资本购置和营运资本变化。",
      "next_check": "下一次正式财报披露。",
      "evidence_ids": [
        "metric-operating_cash_flow",
        "metric-cash_capex",
        "metric-free_cash_flow"
      ]
    }
  ],
  "limitations": [
    "分析依据已列明的官方材料，资料覆盖情况与尚未核验的单季指标分别列出。",
    "财务数值与数值指引来自已核验的财报数据，业务分析根据引用的披露材料解读。",
    "未保留披露前市场一致预期快照。"
  ],
  "summary": {
    "text": "本季 GAAP 净收入同比下滑 15.6%，净预订额下降 18.3%。完整游戏销售回落是收入下滑的主要原因，而营业亏损和现金流也弱于去年同期。管理层在 11 月 9 日披露中维持 FY2027 净预订额 80 亿至 82 亿美元的预期，部分取决于《GTA VI》推出后的销售表现。",
    "evidence_ids": [
      "metric-revenue",
      "take-two-net-bookings",
      "ttwo-review-games",
      "metric-operating_income",
      "metric-free_cash_flow",
      "ttwo-review-launch",
      "take-two-guidance-2027-03-31-bookings"
    ]
  },
  "findings": [
    {
      "kind": "fact",
      "text": "GAAP 净收入为 14.97 亿美元，净预订额为 16.01 亿美元，分别同比下降 15.6% 和 18.3%。净预订额衡量期间内售出的产品和服务，游戏收入则按会计规则确认，两项指标在新品集中上线时的变动可能不同。",
      "evidence_ids": [
        "metric-revenue",
        "take-two-net-bookings"
      ]
    },
    {
      "kind": "fact",
      "text": "毛利率升至 57.5%，但营业亏损从 9800 万美元扩大到 1.175 亿美元。净亏损则从 1.339 亿美元收窄到 5400 万美元，本季确认 5790 万美元税务收益，上年同期为 1840 万美元税费。",
      "evidence_ids": [
        "metric-gross_margin",
        "metric-operating_income",
        "metric-net_income",
        "ttwo-review-tax"
      ]
