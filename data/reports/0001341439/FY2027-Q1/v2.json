  "segments": [
    {
      "name": "云基础设施（IaaS）产品类别",
      "text": "收入 73.88 亿美元，公告披露约增长 121%。这是增长最快的主要类别，但需要较大基础设施投入，收入增速本身不足以证明新增容量的现金回报。",
      "evidence_ids": [
        "business-segment-1"
      ]
    },
    {
      "name": "云应用（SaaS）产品类别",
      "text": "收入 42.19 亿美元，约增长 10%，其应用订阅经济性与增速不同于 IaaS。两者都包含在云收入中，不能与云合计重复计入集团总额。",
      "evidence_ids": [
        "business-segment-2"
      ]
    },
    {
      "name": "软件产品类别",
      "text": "收入 55.50 亿美元，其中许可证 6.55 亿美元、支持服务 48.95 亿美元。云迁移改变组合与确认节奏，将基础设施高速增长与软件收缩合并看待，容易忽略旧有利润及现金基础的变化。",
      "evidence_ids": [
        "business-segment-3"
      ]
    }
  ],
