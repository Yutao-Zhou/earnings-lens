  "guidance": [],
  "segments": [
    {
      "name": "美国服务业务",
      "text": "FY2026 美国服务收入同比减少约 6,330 万美元。管理层指出，上财年 Helene 和 Milton 飓风带来一次性收入，本财年处理量下降，单车收入上升抵消了部分影响。追踪常态保险车供给和单车变现能力比只看全年增速更有信息量。",
      "evidence_ids": [
        "annual-service-us"
      ]
    },
    {
      "name": "国际服务业务",
      "text": "FY2026 国际服务收入同比增加约 6,410 万美元，其中约 2,190 万美元来自有利汇率。剔除汇率后，管理层将增长主要归因于处理量和单车收入同时上升。后续观察量价增长能否继续覆盖当地运营成本。",
      "evidence_ids": [
        "annual-service-international"
      ]
    }
  ],
  "follow_ups": [
    {
      "id": "next-disclosure-1",
      "status": "monitoring",
      "question": "美国服务收入能否恢复增长？",
      "update": "将处理量、单车收入与上年灾害相关基数分别对比。",
      "next_check": "下一次官方业绩公告或申报文件。",
      "evidence_ids": [
        "annual-service-us"
      ]
    },
    {
      "id": "next-disclosure-2",
      "status": "monitoring",
      "question": "毛利率和现金转化能否恢复？",
      "update": "对照服务与整车销售占比、场地处理成本和经营现金流，再核对资本开支。",
      "next_check": "下一次官方业绩公告或申报文件。",
      "evidence_ids": [
        "quarter-sales-mix",
        "metric-gross_margin",
        "metric-free_cash_flow"
      ]
    },
    {
      "id": "next-disclosure-3",
      "status": "monitoring",
      "question": "ACV 首次并表会如何改变增长和利润率？",
      "update": "核对 ACV 披露的收入贡献、并购费用和现金影响，并将其与 Copart 原业务表现区分。",
      "next_check": "下一次官方业绩公告或申报文件。",
      "evidence_ids": [
        "acv-close"
      ]
    }
  ],
  "limitations": [
    "单季现金流由 10-K 全年金额减去前三季累计金额得出。管理层对量价和汇率的解释为全年口径。",
    "财务数值与数值指引来自已核验的财报数据，业务分析根据引用的披露材料解读。",
    "未保留披露前市场一致预期快照。"
  ],
  "summary": {
    "text": "Copart 第四财季营收同比增长 2.4%，毛利率下降 3.53 个百分点，单季自由现金流下降 20.6%。整车销售贡献约一半的新增营收。10 月交割的 ACV Auctions 将扩大经销商批发拍卖业务，收购影响有待后续财报验证。",
    "evidence_ids": [
      "metric-revenue",
      "metric-gross_margin",
      "metric-free_cash_flow",
      "quarter-sales-mix",
      "acv-close"
    ]
  },
  "findings": [
    {
      "kind": "fact",
      "text": "营收为 11.52 亿美元，同比增长 2.4%。服务收入为 9.70 亿美元，增长 1.4%；整车销售收入为 1.83 亿美元，增长 8.3%。整车销售贡献约 1,401 万美元，占新增营收约一半。",
      "evidence_ids": [
        "metric-revenue",
        "quarter-sales-mix"
      ]
    },
    {
      "kind": "fact",
      "text": "GAAP 毛利率从 45.30% 降至 41.78%，营业利润同比下降 10.6% 至 3.69 亿美元。归属母公司净利润下降 17.4%，摊薄 EPS 从 0.41 美元降至 0.35 美元。下一季要看服务收入恢复能否带动毛利率回升。",
      "evidence_ids": [
        "metric-gross_margin",
        "metric-operating_income",
        "metric-net_income",
        "metric-diluted_eps"
      ]
    },
    {
      "kind": "fact",
      "text": "单季经营现金流和现金资本开支分别为 3.58 亿及 7,881 万美元。相减得自由现金流 2.79 亿美元，同比下降 20.6%。资本开支同比下降，经营现金流减少仍拖累了自由现金流。",
      "evidence_ids": [
        "metric-operating_cash_flow",
        "metric-cash_capex",
        "metric-free_cash_flow"
      ]
    },
    {
      "kind": "inference",
      "text": "整车销售比服务收入增长更快，且毛利率同步下降。后续值得对照两类收入的占比和处理成本，判断利润率变化有多少来自业务组合。",
      "evidence_ids": [
        "quarter-sales-mix",
        "metric-gross_margin"
      ]
    },
    {
      "kind": "risk",
      "text": "10-K 提到灾害相关车源会影响年度同比，也会增加拖运和场地的调度压力。FY2025 的飓风相关收入抬高了美国服务业务的基数，判断恢复速度时应分别观察成交量和单车收入。",
      "evidence_ids": [
        "analysis-filing-17",
        "annual-service-us"
      ]
    },
    {
      "kind": "risk",
      "text": "Copart 在季度结束后于 10 月 16 日完成 ACV Auctions 收购。经销商批发拍卖会带来更多车源，但现金支出、整合成本和业务组合变化可能压低短期盈利。首个并表季度应优先核对 ACV 的贡献。",
      "evidence_ids": [
        "acv-close"
      ]
    }
  ]
}
